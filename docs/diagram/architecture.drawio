1;exitY=0.85;" edge="1" parent="1" source="proto-9" target="proto-12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="418"/></Array></mxGeometry></mxCell><mxCell id="proto-22" value="make bucket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="proto-13" target="proto-12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1155" y="600"/></Array></mxGeometry></mxCell><mxCell id="proto-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#AAB7B8;fontColor=#879196;" edge="1" parent="1" source="proto-16" target="proto-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="proto-24" value="&lt;b&gt;Backend routes&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Built on main&lt;/b&gt;&lt;br&gt;POST /api/auth/signup, login, refresh, logout&lt;br&gt;GET, PATCH /api/me&lt;br&gt;POST /api/me/password&lt;br&gt;GET /api/users/:id&lt;br&gt;GET /api/users/:id/tracks&lt;br&gt;POST /api/tracks (upload)&lt;br&gt;GET /api/tracks, /api/tracks/:id&lt;br&gt;PATCH, DELETE /api/tracks/:id&lt;br&gt;GET /api/health&lt;br&gt;&lt;br&gt;&lt;font color='#879196'&gt;&lt;b&gt;To-do&lt;/b&gt;&lt;br&gt;GET /api/tracks/:id/stream, /download (#40)&lt;br&gt;POST /api/tracks/:id/play (#41)&lt;br&gt;Likes, follows, feed, search (phase 3)&lt;br&gt;Reports and admin routes (phase 4)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Security in place&lt;/b&gt;&lt;br&gt;bcrypt passwords, 15 min JWT,&lt;br&gt;HttpOnly refresh cookie (hashed in DB),&lt;br&gt;login and password rate limits,&lt;br&gt;owner checks in SQL, audio type sniffing" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontC