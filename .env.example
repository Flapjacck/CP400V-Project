# Postgres (db service; stands in for Supabase in production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app

# MinIO (S3 stand-in for audio + future frontend assets)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# App DB role (backend connects as this user; keep password URL-safe: letters and numbers)
APP_DB_USER=app
APP_DB_PASSWORD=changeme-app

# S3 / MinIO object storage (audio bucket)
S3_BUCKET=audio
S3_REGION=us-east-1

# Auth (wired up in a later issue; placeholders for Compose)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme