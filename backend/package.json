{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Fastify backend API server",
  "main": "dist/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx/esm src/server.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "keywords": [],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@fastify/autoload": "^6.0.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/jwt": "^10.2.9",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
